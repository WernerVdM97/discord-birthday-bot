# Discord
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
ANNOUNCEMENTS_CHANNEL_ID=

# Schedule (optional — defaults to 7am)
# CRON_SCHEDULE=0 7 * * *

# Admin (optional — gets DM notifications + lock override)
BOT_ADMIN_ID=

# Role-based access (optional — role IDs from Discord)
BOT_ADMIN_ROLE_ID=
BOT_MEMBER_ROLE_ID=

# LLM (OpenRouter, pinned to DeepSeek first-party host)
OPENROUTER_API_KEY=
# Optional override — must be a slug one of the pinned hosts serves
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
