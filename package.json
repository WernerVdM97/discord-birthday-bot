{
  "name": "discord-birthday-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Dank birthday wishes for a private Discord server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "git rev-parse --short HEAD > dist/commit.txt || true",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/"
  },
  "dependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "eslint": "^10.7.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
